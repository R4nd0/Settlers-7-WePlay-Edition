+
+// ACL port checks cannot authenticate non-initial fragments. Reject fragmented
+// or inconsistent IPv4 packets instead of delivering unchecked bytes to TUN.
+fn acl_ipv4_valid(payload: &[u8]) -> bool {
+    let Some(ip) = Ipv4Packet::new(payload) else { return false; };
+    let header = usize::from(ip.get_header_length()) * 4;
+    if ip.get_version() != 4 || header < 20 || header > payload.len()
+        || usize::from(ip.get_total_length()) != payload.len()
+        || ip.get_fragment_offset() != 0 || ip.get_flags() & 5 != 0 {
+        return false;
+    }
+    match ip.get_next_level_protocol() {
+        IpNextHeaderProtocols::Udp => UdpPacket::new(ip.payload()).is_some_and(|udp|
+            udp.get_length() >= 8 && usize::from(udp.get_length()) == ip.payload().len()),
+        IpNextHeaderProtocols::Tcp => TcpPacket::new(ip.payload()).is_some_and(|tcp|
+            tcp.get_data_offset() >= 5 && usize::from(tcp.get_data_offset()) * 4 <= ip.payload().len()),
+        _ => true, // The enabled chains still decide other protocols.
+    }
 }
 
